# ============================================================
# Vita — environment variable template
# Copy to `.env` and fill in your own values. Never commit `.env`.
# ============================================================

# Your Supabase project URL (Dashboard → Project Settings → General)
SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable/anon key (Dashboard → Project Settings → API Keys)
SUPABASE_ANON_KEY=your-anon-key-here

# Secret/service_role key — SERVER-ONLY, never expose client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API key (console.anthropic.com -> API Keys)
# Set this as a Supabase Edge Function secret, not in client code
ANTHROPIC_API_KEY=your-anthropic-key-here

# Your Vercel deployment URL
VERCEL_PROJECT_URL=https://your-project.vercel.app

# Your deployed Edge Function endpoint
EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1/vita-handler

# (Optional, frontend) Override the endpoint the widget calls — e.g. a local
# `supabase functions serve` URL. Defaults to the production endpoint.
# The VITE_ prefix bundles this into the browser; that's fine here because
# the endpoint URL is public by design (protected by CORS + rate limiting).
VITE_VITA_ENDPOINT=https://your-project-ref.supabase.co/functions/v1/vita-handler

# (Optional) Eval harness rate-limit bypass. Generate with `openssl rand -hex 32`,
# set the same value as a Supabase function secret (EVAL_BYPASS_TOKEN) — lets
# `evals/run.py` do full runs without raising RATE_LIMIT_PER_HOUR.
EVAL_BYPASS_TOKEN=your-random-token-here

# (Optional) Deploy-time contact injection. Direct contact details are
# deliberately NOT stored in data/resume.json (it's public). Set these as
# Supabase function secrets; the function merges them into the resume at
# startup. Also set them for the eval judge (here or as CI secrets) so
# injected details aren't graded as hallucinations.
CONTACT_EMAIL=you@example.com
WINKS_PHONE=(555) 555-5555
WINKS_EMAIL=hello@example.com
